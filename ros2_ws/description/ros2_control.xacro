<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
      Common ros2_control contract for both simulation and the future Raspberry
      Pi hardware backend.  Only the plugin name changes between backends; the
      controller-facing joint names and interfaces stay identical.
    -->
    <xacro:macro name="tai_robot_ros2_control" params="hardware_plugin">
        <ros2_control name="TaiRobotSystem" type="system">
            <hardware>
                <plugin>${hardware_plugin}</plugin>
                <xacro:unless value="$(arg use_sim)">
                    <param name="drive_serial_port">$(arg drive_serial_port)</param>
                    <param name="drive_baud">460800</param>
                    <param name="lift_serial_port">$(arg lift_serial_port)</param>
                    <param name="lift_baud">115200</param>
                    <param name="use_lift">$(arg use_lift)</param>
                    <param name="startup_timeout_ms">$(arg serial_startup_timeout_ms)</param>
                    <param name="telemetry_timeout_ms">$(arg serial_telemetry_timeout_ms)</param>
                    <param name="lift_home_timeout_ms">$(arg lift_home_timeout_ms)</param>
                    <param name="home_lift_on_activate">$(arg home_lift_on_activate)</param>
                    <param name="max_wheel_speed_rad_s">${max_wheel_speed_rad_s}</param>
                    <param name="max_lift_position_m">${lift_travel}</param>
                </xacro:unless>
            </hardware>

            <!-- Four independent motor/encoder channels.  The controller
                 groups front/rear wheels by side for skid-steer kinematics. -->
            <joint name="front_left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">${-max_wheel_speed_rad_s}</param>
                    <param name="max">${max_wheel_speed_rad_s}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <xacro:unless value="$(arg use_sim)">
                    <state_interface name="pid_target_velocity"/>
                    <state_interface name="pid_output_pwm"/>
                </xacro:unless>
            </joint>

            <joint name="front_right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">${-max_wheel_speed_rad_s}</param>
                    <param name="max">${max_wheel_speed_rad_s}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <xacro:unless value="$(arg use_sim)">
                    <state_interface name="pid_target_velocity"/>
                    <state_interface name="pid_output_pwm"/>
                </xacro:unless>
            </joint>

            <joint name="rear_left_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">${-max_wheel_speed_rad_s}</param>
                    <param name="max">${max_wheel_speed_rad_s}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <xacro:unless value="$(arg use_sim)">
                    <state_interface name="pid_target_velocity"/>
                    <state_interface name="pid_output_pwm"/>
                </xacro:unless>
            </joint>

            <joint name="rear_right_wheel_joint">
                <command_interface name="velocity">
                    <param name="min">${-max_wheel_speed_rad_s}</param>
                    <param name="max">${max_wheel_speed_rad_s}</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
                <xacro:unless value="$(arg use_sim)">
                    <state_interface name="pid_target_velocity"/>
                    <state_interface name="pid_output_pwm"/>
                </xacro:unless>
            </joint>

            <!-- Position is metres above the mechanical lower stop. In real
                 mode with use_lift=false the combined IMU/lift bridge owns
                 lift_joint and publishes its feedback on /joint_states. -->
            <xacro:if value="$(arg use_sim)">
                <joint name="lift_joint">
                    <command_interface name="effort">
                        <param name="min">${-lift_max_force}</param>
                        <param name="max">${lift_max_force}</param>
                    </command_interface>
                    <state_interface name="position">
                        <param name="initial_value">0.0</param>
                    </state_interface>
                    <state_interface name="velocity"/>
                </joint>
            </xacro:if>
            <xacro:unless value="$(arg use_sim)">
                <xacro:if value="$(arg use_lift)">
                    <joint name="lift_joint">
                        <command_interface name="position">
                            <param name="min">0.0</param>
                            <param name="max">${lift_travel}</param>
                        </command_interface>
                        <state_interface name="position">
                            <param name="initial_value">0.0</param>
                        </state_interface>
                        <state_interface name="velocity"/>
                    </joint>
                </xacro:if>
            </xacro:unless>
        </ros2_control>
    </xacro:macro>

</robot>
