<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
      Gazebo owns the simulated hardware only.  Drive kinematics, odometry,
      joint feedback and lift commands are all handled by ros2_control.
    -->
    <xacro:macro name="gazebo_ros2_control_plugin" params="controllers_file">
        <gazebo>
            <plugin filename="libgz_ros2_control-system.so"
                    name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                <parameters>${controllers_file}</parameters>
                <controller_manager_name>controller_manager</controller_manager_name>
                <hold_joints>true</hold_joints>
                <position_proportional_gain>0.1</position_proportional_gain>
            </plugin>
        </gazebo>
    </xacro:macro>

</robot>
