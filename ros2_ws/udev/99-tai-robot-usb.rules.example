# Copy this file only after replacing every *_SERIAL_HERE placeholder with
# the real value shown by `udevadm info --query=property --name=/dev/ttyUSBX`.
# Placeholder rules intentionally match no normal serial number.

# Four-wheel/base ESP32 USB-UART.
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="DRIVE_ESP32_SERIAL_HERE", SYMLINK+="tai_drive", MODE="0660", GROUP="dialout"

# Lift ESP32 USB-UART.
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="LIFT_ESP32_SERIAL_HERE", SYMLINK+="tai_lift", MODE="0660", GROUP="dialout"

# Give the lidar its own stable name as well. Replace VID/PID/serial with the
# values reported for the actual unit; do not copy an example from the web.
SUBSYSTEM=="tty", ENV{ID_SERIAL_SHORT}=="LIDAR_SERIAL_HERE", SYMLINK+="tai_lidar", MODE="0660", GROUP="dialout"
