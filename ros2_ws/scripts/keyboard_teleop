#!/usr/bin/env python3

"""GUI keyboard teleoperation for the simulated skid-steer base and lift."""

import json
import time
import tkinter as tk

from geometry_msgs.msg import Twist
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import JointState
from std_msgs.msg import Empty, Float64MultiArray, String


HELP = """
Giữ W : tiến             Giữ S : lùi
Giữ W+A : quẹo trái     Giữ W+D : quẹo phải
Giữ S+A/S+D : lùi và quẹo tương ứng
Thả hết W/A/S/D : gửi vận tốc 0
Space : dừng lệnh di chuyển (không thay thế E-stop cứng)

R : nâng càng 2 cm       F : hạ càng 2 cm
T : nâng tối đa 52 cm    G : hạ về 0 cm
H : HOME về công tắc đáy (LOW = đã chạm)

Q : dừng robot và đóng cửa sổ
"""

MAX_LINEAR_SPEED_M_S = 0.50
MAX_ANGULAR_SPEED_RAD_S = 1.20


class KeyboardTeleop(Node):
    """Publish manual velocity and bounded lift-position commands."""

    def __init__(self):
        super().__init__('keyboard_teleop')

        self.declare_parameter('linear_speed', 0.25)
        self.declare_parameter('angular_speed', 0.80)
        self.declare_parameter('lift_step', 0.02)
        self.declare_parameter('lift_min', 0.0)
        self.declare_parameter('lift_max', 0.52)
        self.declare_parameter('publish_rate', 20.0)

        self.linear_speed = float(self.get_parameter('linear_speed').value)
        self.angular_speed = float(self.get_parameter('angular_speed').value)
        self.lift_step = float(self.get_parameter('lift_step').value)
        self.lift_min = float(self.get_parameter('lift_min').value)
        self.lift_max = float(self.get_parameter('lift_max').value)
        self.publish_rate = float(self.get_parameter('publish_rate').value)

        if not 0.0 <= self.lift_min < self.lift_max <= 0.52:
            raise ValueError('lift limits must stay inside [0.0, 0.52] m')
        if not 0.0 <= self.linear_speed <= MAX_LINEAR_SPEED_M_S:
            raise ValueError('linear_speed must stay inside [0.0, 0.50] m/s')
        if not 0.0 <= self.angular_speed <= MAX_ANGULAR_SPEED_RAD_S:
            raise ValueError('angular_speed must stay inside [0.0, 1.20] rad/s')
        if self.publish_rate <= 0.0:
            raise ValueError('publish_rate must be positive')

        self.cmd_vel_publisher = self.create_publisher(Twist, '/cmd_vel', 10)
        self.lift_publisher = self.create_publisher(
            Float64MultiArray, '/lift_controller/commands', 10)
        self.lift_home_publisher = self.create_publisher(Empty, '/lift/home', 10)
        self.lift_status_subscription = self.create_subscription(
            String, '/lift/status', self.lift_status_callback, 10)
        self.joint_state_subscription = self.create_subscription(
            JointState,
            '/joint_states',
            self.joint_state_callback,
            qos_profile_sensor_data,
        )

        self.linear = 0.0
        self.angular = 0.0
        self.lift_target = self.lift_min
        self.lift_command_active = False
        self.lift_serial_connected = False
        self.lift_homed = False
        self.lift_state = 'CHƯA CÓ DỮ LIỆU'
        self.lift_fault = 'NONE'
        self.lower_limit_active = False
        self.upper_limit_active = False
        self.last_lift_status_time = 0.0
        self.pressed_keys = set()
        self.running = True

    def joint_state_callback(self, message):
        """Initialize the lift target from Gazebo instead of forcing it to 0."""
        if self.lift_command_active:
            return
        try:
            index = message.name.index('lift_joint')
        except ValueError:
            return
        if index < len(message.position):
            self.lift_target = min(
                self.lift_max,
                max(self.lift_min, message.position[index]))

    def lift_status_callback(self, message):
        """Track homing and endstop feedback reported by ESP32 number 2."""
        try:
            status = json.loads(message.data)
        except (json.JSONDecodeError, TypeError):
            return
        self.last_lift_status_time = time.monotonic()
        self.lift_serial_connected = bool(status.get('serial_connected', False))
        if 'homed' in status:
            self.lift_homed = bool(status['homed'])
            self.lift_state = str(status.get('state', 'UNKNOWN'))
            self.lift_fault = str(status.get('fault', 'NONE'))
            self.lower_limit_active = bool(status.get('lower_active', False))
            self.upper_limit_active = bool(status.get('upper_active', False))
            if 'position' in status and not self.lift_command_active:
                self.lift_target = min(
                    self.lift_max,
                    max(self.lift_min, float(status['position'])))

    def request_lift_home(self):
        """Ask firmware to seek the lower switch before assigning zero."""
        self.lift_command_active = False
        self.lift_home_publisher.publish(Empty())

    def press_key(self, key):
        """Handle one physical key-down event."""
        if key in self.pressed_keys:
            return
        self.pressed_keys.add(key)

        if key in ('w', 'a', 's', 'd'):
            self.update_drive_from_keys()
        elif key == 'space':
            self.release_drive_keys()
        elif key == 'r':
            self.lift_command_active = True
            self.lift_target = min(
                self.lift_max, self.lift_target + self.lift_step)
        elif key == 'f':
            self.lift_command_active = True
            self.lift_target = max(
                self.lift_min, self.lift_target - self.lift_step)
        elif key == 't':
            self.lift_command_active = True
            self.lift_target = self.lift_max
        elif key == 'g':
            self.lift_command_active = True
            self.lift_target = self.lift_min
        elif key == 'h':
            self.request_lift_home()

    def release_key(self, key):
        """Handle one physical key-up event."""
        self.pressed_keys.discard(key)
        if key in ('w', 'a', 's', 'd'):
            self.update_drive_from_keys()

    def update_drive_from_keys(self):
        """Calculate Twist from the complete set of keys still held down."""
        forward = int('w' in self.pressed_keys)
        reverse = int('s' in self.pressed_keys)
        left = int('a' in self.pressed_keys)
        right = int('d' in self.pressed_keys)
        self.linear = self.linear_speed * (forward - reverse)
        self.angular = self.angular_speed * (left - right)

    def set_linear_speed(self, speed):
        """Update the GUI speed limit and any command currently being held."""
        self.linear_speed = min(MAX_LINEAR_SPEED_M_S, max(0.0, float(speed)))
        self.update_drive_from_keys()

    def set_angular_speed(self, speed):
        """Update the GUI turn-rate limit and any command currently held."""
        self.angular_speed = min(
            MAX_ANGULAR_SPEED_RAD_S, max(0.0, float(speed)))
        self.update_drive_from_keys()

    def release_drive_keys(self):
        """Clear all drive keys and stop the base immediately."""
        self.pressed_keys.difference_update(('w', 'a', 's', 'd'))
        self.linear, self.angular = 0.0, 0.0

    def release_all_keys(self):
        """Fail-safe stop used when the control window loses focus."""
        self.pressed_keys.clear()
        self.linear, self.angular = 0.0, 0.0

    def publish(self):
        twist = Twist()
        twist.linear.x = min(
            MAX_LINEAR_SPEED_M_S, max(-MAX_LINEAR_SPEED_M_S, self.linear))
        twist.angular.z = min(
            MAX_ANGULAR_SPEED_RAD_S,
            max(-MAX_ANGULAR_SPEED_RAD_S, self.angular))
        self.cmd_vel_publisher.publish(twist)

        if self.lift_command_active:
            lift = Float64MultiArray()
            lift.data = [self.lift_target]
            self.lift_publisher.publish(lift)

    def status(self):
        drive_keys = '+'.join(
            key.upper() for key in ('w', 'a', 's', 'd')
            if key in self.pressed_keys)
        return (
            f'V={self.linear:+.2f} m/s  W={self.angular:+.2f} rad/s  '
            f'Giới hạn V={self.linear_speed:.2f} m/s  '
            f'W={self.angular_speed:.2f} rad/s  '
            f'Lift={self.lift_target:.2f} m  Home={"OK" if self.lift_homed else "--"}  '
            f'Phím={drive_keys or "-"}')


class TeleopWindow:
    """Focused Tk window that provides reliable key-down/key-up events."""

    CONTROL_KEYS = frozenset(('w', 'a', 's', 'd', 'r', 'f', 't', 'g', 'h', 'space'))

    def __init__(self, node):
        self.node = node
        self.root = tk.Tk()
        self.root.title('TAI Robot One - Keyboard Teleop')
        self.root.geometry('700x735')
        self.root.minsize(640, 680)
        self.root.configure(background='#20252b')
        self.closing = False
        self.pending_releases = {}

        title = tk.Label(
            self.root,
            text='TAI ROBOT ONE - ĐIỀU KHIỂN BẰNG PHÍM',
            font=('Sans', 15, 'bold'),
            foreground='#ffffff',
            background='#20252b',
        )
        title.pack(pady=(18, 8))

        instructions = tk.Label(
            self.root,
            text=HELP.strip(),
            justify=tk.LEFT,
            font=('Monospace', 11),
            foreground='#e8edf2',
            background='#20252b',
        )
        instructions.pack(padx=24, anchor='w')

        drive_frame = tk.Frame(self.root, background='#20252b')
        drive_frame.pack(pady=(10, 4))
        self.make_drive_button(drive_frame, 'W', 'w', 0, 1)
        self.make_drive_button(drive_frame, 'A', 'a', 1, 0)
        self.make_drive_button(drive_frame, 'S', 's', 1, 1)
        self.make_drive_button(drive_frame, 'D', 'd', 1, 2)

        stop_button = tk.Button(
            drive_frame,
            text='DỪNG',
            font=('Sans', 10, 'bold'),
            width=9,
            background='#b91c1c',
            foreground='#ffffff',
            activebackground='#ef4444',
            activeforeground='#ffffff',
            takefocus=False,
        )
        stop_button.grid(row=2, column=0, columnspan=3, pady=(5, 0))
        stop_button.bind('<ButtonPress-1>', self.on_stop_button)

        speed_frame = tk.Frame(self.root, background='#20252b')
        speed_frame.pack(fill=tk.X, padx=28, pady=(10, 4))
        tk.Label(
            speed_frame,
            text='Giới hạn tốc độ xe (tối đa 0.50 m/s)',
            font=('Sans', 10, 'bold'),
            foreground='#ffffff',
            background='#20252b',
        ).pack(anchor='w')
        self.speed_value = tk.StringVar()
        self.speed_scale = tk.Scale(
            speed_frame,
            from_=0.0,
            to=MAX_LINEAR_SPEED_M_S,
            resolution=0.01,
            orient=tk.HORIZONTAL,
            length=500,
            showvalue=False,
            background='#20252b',
            foreground='#ffffff',
            troughcolor='#374151',
            highlightthickness=0,
            takefocus=False,
        )
        self.speed_scale.set(self.node.linear_speed)
        self.speed_scale.configure(command=self.on_speed_changed)
        self.speed_scale.pack(side=tk.LEFT, fill=tk.X, expand=True)
        tk.Label(
            speed_frame,
            textvariable=self.speed_value,
            width=10,
            font=('Monospace', 10, 'bold'),
            foreground='#facc15',
            background='#20252b',
        ).pack(side=tk.RIGHT)
        self.update_speed_label()

        turn_frame = tk.Frame(self.root, background='#20252b')
        turn_frame.pack(fill=tk.X, padx=28, pady=(4, 4))
        tk.Label(
            turn_frame,
            text='Giới hạn tốc độ xoay (tối đa 1.20 rad/s)',
            font=('Sans', 10, 'bold'),
            foreground='#ffffff',
            background='#20252b',
        ).pack(anchor='w')
        self.turn_value = tk.StringVar()
        self.turn_scale = tk.Scale(
            turn_frame,
            from_=0.0,
            to=MAX_ANGULAR_SPEED_RAD_S,
            resolution=0.05,
            orient=tk.HORIZONTAL,
            length=500,
            showvalue=False,
            background='#20252b',
            foreground='#ffffff',
            troughcolor='#374151',
            highlightthickness=0,
            takefocus=False,
        )
        self.turn_scale.set(self.node.angular_speed)
        self.turn_scale.configure(command=self.on_turn_changed)
        self.turn_scale.pack(side=tk.LEFT, fill=tk.X, expand=True)
        tk.Label(
            turn_frame,
            textvariable=self.turn_value,
            width=12,
            font=('Monospace', 10, 'bold'),
            foreground='#facc15',
            background='#20252b',
        ).pack(side=tk.RIGHT)
        self.update_turn_label()

        lift_frame = tk.LabelFrame(
            self.root,
            text='Điều khiển càng nâng',
            font=('Sans', 10, 'bold'),
            foreground='#ffffff',
            background='#20252b',
            padx=8,
            pady=7,
        )
        lift_frame.pack(fill=tk.X, padx=28, pady=(6, 4))
        self.lift_buttons = []
        for label, key in (
                ('Nâng +2 cm', 'r'), ('Hạ -2 cm', 'f'),
                ('Nâng tối đa', 't'), ('Hạ về 0', 'g')):
            button = tk.Button(
                lift_frame,
                text=label,
                command=lambda selected=key: self.lift_action(selected),
                takefocus=False,
            )
            button.pack(side=tk.LEFT, padx=3, expand=True, fill=tk.X)
            self.lift_buttons.append(button)
        self.home_button = tk.Button(
            lift_frame,
            text='HOME đáy',
            command=lambda: self.lift_action('h'),
            background='#1d4ed8',
            foreground='#ffffff',
            activebackground='#2563eb',
            activeforeground='#ffffff',
            takefocus=False,
        )
        self.home_button.pack(side=tk.LEFT, padx=3, expand=True, fill=tk.X)
        self.lift_connection_label = tk.Label(
            self.root,
            text='Càng: đang kiểm tra controller...',
            font=('Sans', 9, 'bold'),
            foreground='#facc15',
            background='#20252b',
        )
        self.lift_connection_label.pack(pady=(0, 3))
        self.lift_available = None

        self.focus_label = tk.Label(
            self.root,
            text='Cửa sổ đang nhận phím',
            font=('Sans', 11, 'bold'),
            foreground='#4ade80',
            background='#20252b',
        )
        self.focus_label.pack(pady=(14, 5))

        self.status_label = tk.Label(
            self.root,
            text=self.node.status(),
            font=('Monospace', 11, 'bold'),
            foreground='#facc15',
            background='#111418',
            padx=12,
            pady=8,
        )
        self.status_label.pack(fill=tk.X, padx=18, pady=(0, 12))

        self.root.bind_all('<KeyPress>', self.on_key_press)
        self.root.bind_all('<KeyRelease>', self.on_key_release)
        self.root.bind_all('<Button-1>', self.on_mouse_activate, add='+')
        self.root.bind('<FocusIn>', self.on_focus_in)
        self.root.bind('<FocusOut>', self.on_focus_out)
        self.root.protocol('WM_DELETE_WINDOW', self.close)

        period_ms = max(1, round(1000.0 / self.node.publish_rate))
        self.root.after(period_ms, self.tick)
        self.root.after(100, self.root.focus_force)

    def make_drive_button(self, parent, label, key, row, column):
        """Create a hold-to-drive mouse button with release-to-stop safety."""
        button = tk.Button(
            parent,
            text=label,
            font=('Sans', 13, 'bold'),
            width=5,
            height=1,
            background='#374151',
            foreground='#ffffff',
            activebackground='#2563eb',
            activeforeground='#ffffff',
            takefocus=False,
        )
        button.grid(row=row, column=column, padx=3, pady=2)
        button.bind('<ButtonPress-1>', lambda _event: self.mouse_press(key))
        button.bind('<ButtonRelease-1>', lambda _event: self.mouse_release(key))
        button.bind('<Leave>', lambda _event: self.mouse_release(key))

    def mouse_press(self, key):
        self.node.press_key(key)
        self.node.publish()
        self.refresh_status()

    def mouse_release(self, key):
        self.node.release_key(key)
        self.node.publish()
        self.refresh_status()

    def on_stop_button(self, _event):
        self.node.release_drive_keys()
        self.node.publish()
        self.refresh_status()
        return 'break'

    def on_speed_changed(self, value):
        self.node.set_linear_speed(value)
        self.node.publish()
        self.update_speed_label()
        self.refresh_status()

    def update_speed_label(self):
        self.speed_value.set(f'{self.node.linear_speed:.2f} m/s')

    def on_turn_changed(self, value):
        self.node.set_angular_speed(value)
        self.node.publish()
        self.update_turn_label()
        self.refresh_status()

    def update_turn_label(self):
        self.turn_value.set(f'{self.node.angular_speed:.2f} rad/s')

    def lift_action(self, key):
        """Apply one bounded lift step only while a controller is connected."""
        if not self.lift_available:
            return
        if key != 'h' and not self.node.lift_homed:
            return
        self.node.press_key(key)
        self.node.release_key(key)
        self.node.publish()
        self.refresh_status()

    def update_lift_availability(self):
        status_fresh = time.monotonic() - self.node.last_lift_status_time < 1.0
        available = (
            self.node.lift_publisher.get_subscription_count() > 0 and
            self.node.lift_home_publisher.get_subscription_count() > 0 and
            status_fresh and self.node.lift_serial_connected)
        homed = available and self.node.lift_homed
        self.lift_available = available
        for button in self.lift_buttons:
            button.configure(state=tk.NORMAL if homed else tk.DISABLED)
        self.home_button.configure(state=tk.NORMAL if available else tk.DISABLED)
        if available and self.node.lift_fault != 'NONE':
            self.lift_connection_label.configure(
                text=f'Càng: LỖI {self.node.lift_fault} - kiểm tra rồi bấm HOME',
                foreground='#fb7185')
        elif available and self.node.lift_state == 'HOMING':
            self.lift_connection_label.configure(
                text='Càng: ĐANG HOME xuống công tắc đáy...', foreground='#facc15')
        elif available and homed:
            self.lift_connection_label.configure(
                text=(
                    'Càng: ĐÃ HOME | đáy=' +
                    ('CHẠM' if self.node.lower_limit_active else 'thả') +
                    ' | đỉnh=' +
                    ('CHẠM' if self.node.upper_limit_active else 'thả')),
                foreground='#4ade80')
        elif available:
            self.lift_connection_label.configure(
                text='Càng: CHƯA HOME - chỉ nút HOME được mở',
                foreground='#facc15')
        else:
            self.lift_connection_label.configure(
                text='Càng: MẤT KẾT NỐI ESP32 - các nút đang khóa',
                foreground='#fb7185')

    def on_mouse_activate(self, _event):
        # Some Linux window managers reject focus_force during startup. A real
        # user click is allowed to claim keyboard focus reliably.
        self.root.after_idle(self.root.focus_force)

    @staticmethod
    def normalize_key(event):
        key = event.keysym.lower()
        return 'space' if key == 'space' else key

    def on_key_press(self, event):
        key = self.normalize_key(event)
        if key == 'q':
            self.close()
            return 'break'
        if key not in self.CONTROL_KEYS:
            return None

        # X11 may synthesize KeyRelease/KeyPress pairs during auto-repeat.
        # Cancel that pending release so a held key remains continuously active.
        release_id = self.pending_releases.pop(key, None)
        if release_id is not None:
            self.root.after_cancel(release_id)
        self.node.press_key(key)
        self.node.publish()
        self.refresh_status()
        return 'break'

    def on_key_release(self, event):
        key = self.normalize_key(event)
        if key not in self.CONTROL_KEYS:
            return None
        old_release_id = self.pending_releases.pop(key, None)
        if old_release_id is not None:
            self.root.after_cancel(old_release_id)
        self.pending_releases[key] = self.root.after_idle(
            self.finish_key_release, key)
        return 'break'

    def finish_key_release(self, key):
        self.pending_releases.pop(key, None)
        self.node.release_key(key)
        self.node.publish()
        self.refresh_status()

    def on_focus_in(self, _event):
        if self.closing:
            return
        self.focus_label.configure(
            text='Cửa sổ đang nhận phím', foreground='#4ade80')

    def on_focus_out(self, _event):
        if self.closing:
            return
        self.cancel_pending_releases()
        self.node.release_all_keys()
        self.node.publish()
        self.focus_label.configure(
            text='MẤT FOCUS - ROBOT ĐÃ DỪNG (bấm vào cửa sổ)',
            foreground='#fb7185',
        )
        self.refresh_status()

    def cancel_pending_releases(self):
        for release_id in self.pending_releases.values():
            self.root.after_cancel(release_id)
        self.pending_releases.clear()

    def refresh_status(self):
        self.status_label.configure(text=self.node.status())

    def tick(self):
        if self.closing:
            return
        if not rclpy.ok():
            self.close()
            return
        rclpy.spin_once(self.node, timeout_sec=0.0)
        self.update_lift_availability()
        self.node.publish()
        self.refresh_status()
        period_ms = max(1, round(1000.0 / self.node.publish_rate))
        self.root.after(period_ms, self.tick)

    def close(self):
        if self.closing:
            return
        self.closing = True
        self.cancel_pending_releases()
        self.node.release_all_keys()
        self.node.publish()
        self.root.destroy()

    def run(self):
        self.root.mainloop()


def main(args=None):
    rclpy.init(args=args)
    node = KeyboardTeleop()
    try:
        window = TeleopWindow(node)
        window.run()
    finally:
        node.release_all_keys()
        node.publish()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
