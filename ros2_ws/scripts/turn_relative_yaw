#!/usr/bin/env python3

"""Turn the real base through a relative yaw using /odom feedback."""

import argparse
import math
import time

from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
import rclpy
from rclpy.node import Node


def yaw_from_quaternion(q):
    """Return planar yaw in radians."""
    return math.atan2(
        2.0 * (q.w * q.z + q.x * q.y),
        1.0 - 2.0 * (q.y * q.y + q.z * q.z))


class RelativeYawTurn(Node):
    """Closed-loop relative turn with a timeout and repeated stop command."""

    def __init__(self, target_degrees, max_speed, min_speed, timeout):
        super().__init__('turn_relative_yaw')
        self.target = math.radians(target_degrees)
        self.direction = 1.0 if self.target >= 0.0 else -1.0
        self.target = abs(self.target)
        self.max_speed = max_speed
        self.min_speed = min_speed
        self.timeout = timeout
        self.publisher = self.create_publisher(Twist, '/cmd_vel', 10)
        self.create_subscription(Odometry, '/odom', self.odom_callback, 20)
        self.previous_yaw = None
        self.travelled = 0.0
        self.started = None
        self.finished = False
        self.stop_cycles = 0
        self.create_timer(0.05, self.control)

    def odom_callback(self, message):
        yaw = yaw_from_quaternion(message.pose.pose.orientation)
        if self.previous_yaw is None:
            self.previous_yaw = yaw
            self.started = time.monotonic()
            return
        delta = math.atan2(
            math.sin(yaw - self.previous_yaw),
            math.cos(yaw - self.previous_yaw))
        self.travelled += self.direction * delta
        self.previous_yaw = yaw

    def publish_speed(self, angular):
        command = Twist()
        command.angular.z = angular
        self.publisher.publish(command)

    def control(self):
        if self.started is None:
            return
        if self.finished:
            self.publish_speed(0.0)
            self.stop_cycles += 1
            if self.stop_cycles >= 20:
                self.get_logger().info(
                    f'Stopped at {math.degrees(self.travelled):.2f} deg')
                raise SystemExit
            return
        if time.monotonic() - self.started > self.timeout:
            self.get_logger().error('Turn timeout; stopping the base')
            self.finished = True
            return

        remaining = self.target - self.travelled
        # The loaded platform cannot reliably move below 0.25 rad/s. Use the
        # measured EKF angle to brake early by roughly the stopping distance
        # at 1.5 rad/s^2, with a small fixed allowance for command latency.
        speed = self.max_speed if remaining > math.radians(18.0) else self.min_speed
        # First loaded 90-degree test sent zero at 89.204 degrees and coasted
        # another 1.919 degrees. Increasing the fixed allowance from 0.8 to
        # 1.9 degrees moves the zero command about 1.1 degrees earlier.
        braking_angle = speed * speed / (2.0 * 1.5) + math.radians(1.9)
        if remaining <= braking_angle:
            self.finished = True
            self.publish_speed(0.0)
            return
        self.publish_speed(self.direction * speed)


def main(args=None):
    parser = argparse.ArgumentParser()
    parser.add_argument('--degrees', type=float, required=True,
                        help='positive=left, negative=right')
    parser.add_argument('--max-speed', type=float, default=0.35)
    parser.add_argument('--min-speed', type=float, default=0.25)
    parser.add_argument('--timeout', type=float, default=30.0)
    parsed, ros_args = parser.parse_known_args(args)
    if not 0.25 <= parsed.min_speed <= parsed.max_speed <= 0.35:
        parser.error('require 0.25 <= min-speed <= max-speed <= 0.35')
    if not 0.0 < abs(parsed.degrees) <= 360.0:
        parser.error('degrees must be non-zero and at most 360')

    rclpy.init(args=ros_args)
    node = RelativeYawTurn(
        parsed.degrees, parsed.max_speed, parsed.min_speed, parsed.timeout)
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, SystemExit):
        pass
    finally:
        for _ in range(10):
            node.publish_speed(0.0)
            rclpy.spin_once(node, timeout_sec=0.02)
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
