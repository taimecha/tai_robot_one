#!/usr/bin/env python3
"""Read-only planar clearance check for the unmodified warehouse test world.

Uses Gazebo ground truth, never feeds it to navigation. The rack is conservatively
treated as a solid bounding box. This is a geometric check, not a contact sensor.
"""
import json
import math
import subprocess
import time


def box(x, y, sx, sy):
    return [(x-sx/2, y-sy/2), (x+sx/2, y-sy/2),
            (x+sx/2, y+sy/2), (x-sx/2, y+sy/2)]


def separated(a, b):
    for polygon in (a, b):
        for i, p in enumerate(polygon):
            q = polygon[(i+1) % len(polygon)]
            nx, ny = p[1]-q[1], q[0]-p[0]
            pa = [x*nx+y*ny for x, y in a]
            pb = [x*nx+y*ny for x, y in b]
            if max(pa) < min(pb) or max(pb) < min(pa):
                return True
    return False


def distance(a, b):
    if not separated(a, b):
        return 0.0
    best = math.inf
    for vertices, edges in ((a, b), (b, a)):
        for x, y in vertices:
            for i, (px, py) in enumerate(edges):
                qx, qy = edges[(i+1) % len(edges)]
                dx, dy = qx-px, qy-py
                t = max(0.0, min(1.0, ((x-px)*dx+(y-py)*dy)/(dx*dx+dy*dy)))
                best = min(best, math.hypot(x-px-t*dx, y-py-t*dy))
    return best


def main():
    # Envelope contains chassis, wheels, mast, carriage and both fork tips.
    footprint = [(.78, .10), (.78, -.10), (.38, -.25),
                 (-.33, -.25), (-.33, .25), (.38, .25)]
    obstacles = {
        'rack_bbox': box(2, 0, .82, 1.31),
        'south_pillar': box(.3, -1.1, .22, .22),
        'west_pillar': box(-.8, 1, .18, .18),
        'north_pillar': box(1.1, 1.25, .25, .25),
        'south_wall': box(1, -2.5, 7, .1),
        'north_wall': box(1, 4.5, 7, .1),
        'west_wall': box(-2.5, 1, .1, 7),
        'east_wall': box(4.5, 1, .1, 7),
    }
    process = subprocess.Popen(
        ['gz', 'topic', '-e', '-t', '/world/warehouse/pose/info'],
        stdout=subprocess.PIPE, text=True)
    section = None
    active = False
    depth = 0
    values = {}
    best = math.inf
    last_reported_best = math.inf
    samples = 0
    overlap_samples = 0
    next_report = time.monotonic() + 10
    try:
        for line in process.stdout:
            stripped = line.strip()
            if line.startswith('pose {'):
                depth = 1
                values = {}
                active = False
                section = None
                continue
            if not depth:
                continue
            if stripped == 'name: "tai_robot_one"':
                active = True
            if stripped in ('position {', 'orientation {'):
                section = stripped.split()[0]
            if active and section and ':' in stripped:
                key, value = stripped.split(':', 1)
                if key in ('x', 'y', 'z', 'w'):
                    values[section+'_'+key] = float(value)
            depth += line.count('{')-line.count('}')
            if depth or not active:
                continue
            x, y = values.get('position_x', 0), values.get('position_y', 0)
            qx, qy, qz, qw = [values.get('orientation_'+k, 0) for k in ('x', 'y', 'z', 'w')]
            yaw = math.atan2(2*(qw*qz+qx*qy), 1-2*(qy*qy+qz*qz))
            c, s = math.cos(yaw), math.sin(yaw)
            body = [(x+c*px-s*py, y+s*px+c*py) for px, py in footprint]
            name, clearance = min(
                ((name, distance(body, ob)) for name, ob in obstacles.items()),
                key=lambda item: item[1])
            samples += 1
            overlap_samples += clearance == 0.0
            if clearance < best:
                best = clearance
            if clearance < last_reported_best - .005:
                last_reported_best = clearance
                print(json.dumps({'event': 'minimum', 'clearance_m': best,
                                  'obstacle': name, 'pose': [x, y, yaw]}), flush=True)
            if time.monotonic() > next_report:
                print(json.dumps({'samples': samples, 'minimum_clearance_m': best,
                                  'overlap_samples': overlap_samples}), flush=True)
                next_report += 10
    except KeyboardInterrupt:
        pass
    finally:
        process.terminate()
        process.wait(timeout=5)
        print(json.dumps({'final_samples': samples, 'minimum_clearance_m': best,
                          'overlap_samples': overlap_samples}), flush=True)


if __name__ == '__main__':
    main()
