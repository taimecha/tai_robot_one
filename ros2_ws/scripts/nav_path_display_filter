#!/usr/bin/env python3

"""Relay Nav2 paths for RViz and clear them when navigation finishes."""

import rclpy
from action_msgs.msg import GoalStatus, GoalStatusArray
from nav_msgs.msg import Path
from rclpy.node import Node


class NavPathDisplayFilter(Node):
    def __init__(self):
        super().__init__('nav_path_display_filter')
        self._navigation_active = False

        self._global_pub = self.create_publisher(Path, '/rviz/plan', 10)
        self._local_pub = self.create_publisher(Path, '/rviz/local_plan', 10)
        self.create_subscription(Path, '/plan', self._relay_global, 10)
        self.create_subscription(Path, '/local_plan', self._relay_local, 10)
        self.create_subscription(
            GoalStatusArray,
            '/navigate_to_pose/_action/status',
            self._status_callback,
            10,
        )

    def _relay_global(self, message):
        if self._navigation_active:
            self._global_pub.publish(message)

    def _relay_local(self, message):
        if self._navigation_active:
            self._local_pub.publish(message)

    def _status_callback(self, message):
        active_states = {
            GoalStatus.STATUS_ACCEPTED,
            GoalStatus.STATUS_EXECUTING,
            GoalStatus.STATUS_CANCELING,
        }
        active = any(item.status in active_states for item in message.status_list)

        if self._navigation_active and not active:
            self._clear_paths()
        self._navigation_active = active

    def _clear_paths(self):
        stamp = self.get_clock().now().to_msg()

        global_path = Path()
        global_path.header.stamp = stamp
        global_path.header.frame_id = 'map'
        self._global_pub.publish(global_path)

        local_path = Path()
        local_path.header.stamp = stamp
        local_path.header.frame_id = 'odom'
        self._local_pub.publish(local_path)
        self.get_logger().info('Navigation finished; cleared RViz path displays')


def main(args=None):
    rclpy.init(args=args)
    node = NavPathDisplayFilter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
