#!/usr/bin/env python3

import math

import rclpy
from builtin_interfaces.msg import Time
from rclpy.node import Node
from rclpy.qos import QoSProfile, ReliabilityPolicy, qos_profile_sensor_data
from sensor_msgs.msg import LaserScan


def filter_ranges(scan, min_x, max_x, min_y, max_y):
    """Return ranges with points inside the robot's lidar shadow removed."""
    ranges = list(scan.ranges)
    for index, distance in enumerate(ranges):
        if not math.isfinite(distance):
            continue
        angle = scan.angle_min + index * scan.angle_increment
        x = distance * math.cos(angle)
        y = distance * math.sin(angle)
        if min_x <= x <= max_x and min_y <= y <= max_y:
            ranges[index] = math.inf
    return ranges


class ScanSelfFilter(Node):
    def __init__(self):
        super().__init__('scan_self_filter')
        self.declare_parameter('input_topic', '/scan')
        self.declare_parameter('output_topic', '/scan_filtered')
        self.declare_parameter('rviz_output_topic', '/scan_filtered_rviz')
        self.declare_parameter('min_x', 0.42)
        self.declare_parameter('max_x', 0.51)
        self.declare_parameter('min_y', -0.155)
        self.declare_parameter('max_y', 0.155)

        self.min_x = float(self.get_parameter('min_x').value)
        self.max_x = float(self.get_parameter('max_x').value)
        self.min_y = float(self.get_parameter('min_y').value)
        self.max_y = float(self.get_parameter('max_y').value)
        input_topic = str(self.get_parameter('input_topic').value)
        output_topic = str(self.get_parameter('output_topic').value)
        rviz_output_topic = str(
            self.get_parameter('rviz_output_topic').value)

        self.publisher = self.create_publisher(
            LaserScan, output_topic, qos_profile_sensor_data)
        self.rviz_publisher = self.create_publisher(
            LaserScan, rviz_output_topic,
            QoSProfile(depth=10, reliability=ReliabilityPolicy.RELIABLE))
        self.subscription = self.create_subscription(
            LaserScan, input_topic, self._scan_callback,
            qos_profile_sensor_data)
        self.get_logger().info(
            f'Filtering {input_topic} -> {output_topic} '
            f'(RViz: {rviz_output_topic}); lidar-frame box '
            f'x=[{self.min_x:.3f}, {self.max_x:.3f}], '
            f'y=[{self.min_y:.3f}, {self.max_y:.3f}] m')

    def _scan_callback(self, scan):
        filtered = LaserScan()
        filtered.header = scan.header
        filtered.angle_min = scan.angle_min
        filtered.angle_max = scan.angle_max
        filtered.angle_increment = scan.angle_increment
        filtered.time_increment = scan.time_increment
        filtered.scan_time = scan.scan_time
        filtered.range_min = scan.range_min
        filtered.range_max = scan.range_max
        filtered.ranges = filter_ranges(
            scan, self.min_x, self.max_x, self.min_y, self.max_y)
        filtered.intensities = scan.intensities
        self.publisher.publish(filtered)

        # A zero stamp asks RViz to use the latest transform. Keep the
        # accurately stamped output above for SLAM and navigation.
        rviz_scan = LaserScan()
        rviz_scan.header.frame_id = filtered.header.frame_id
        rviz_scan.header.stamp = Time()
        rviz_scan.angle_min = filtered.angle_min
        rviz_scan.angle_max = filtered.angle_max
        rviz_scan.angle_increment = filtered.angle_increment
        rviz_scan.time_increment = filtered.time_increment
        rviz_scan.scan_time = filtered.scan_time
        rviz_scan.range_min = filtered.range_min
        rviz_scan.range_max = filtered.range_max
        rviz_scan.ranges = filtered.ranges
        rviz_scan.intensities = filtered.intensities
        self.rviz_publisher.publish(rviz_scan)


def main(args=None):
    rclpy.init(args=args)
    node = ScanSelfFilter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        try:
            node.destroy_node()
            if rclpy.ok():
                rclpy.try_shutdown()
        except KeyboardInterrupt:
            pass


if __name__ == '__main__':
    main()
