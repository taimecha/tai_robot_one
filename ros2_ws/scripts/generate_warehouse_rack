#!/usr/bin/env python3
"""Generate the 4-bay, 2-level, double-sided warehouse rack SDF."""

from pathlib import Path
import xml.etree.ElementTree as ET


BAY_COUNT = 4
BAY_CLEAR_WIDTH = 0.290
POST_SIZE = 0.030
RACK_DEPTH = 0.820
RACK_HEIGHT = 0.680
RAIL_LENGTH = 0.750
RAIL_WIDTH = 0.025
RAIL_HEIGHT = 0.020
PALLET_RUNNER_OFFSET = 0.110
SUPPORT_LEVELS = (0.090, 0.370)

FRAME_COLOR = (0.18, 0.26, 0.34, 1.0)
RAIL_COLOR = (0.86, 0.58, 0.08, 1.0)


def values(items):
    """Format numeric SDF values compactly and consistently."""
    return " ".join(f"{item:.4f}" for item in items)


def add_box(link, name, pose, size, color):
    """Add matching collision and visual boxes to a link."""
    collision = ET.SubElement(link, "collision", name=f"{name}_collision")
    ET.SubElement(collision, "pose").text = values(pose)
    geometry = ET.SubElement(collision, "geometry")
    box = ET.SubElement(geometry, "box")
    ET.SubElement(box, "size").text = values(size)

    surface = ET.SubElement(collision, "surface")
    friction = ET.SubElement(surface, "friction")
    ode = ET.SubElement(friction, "ode")
    ET.SubElement(ode, "mu").text = "0.8"
    ET.SubElement(ode, "mu2").text = "0.8"

    visual = ET.SubElement(link, "visual", name=f"{name}_visual")
    ET.SubElement(visual, "pose").text = values(pose)
    geometry = ET.SubElement(visual, "geometry")
    box = ET.SubElement(geometry, "box")
    ET.SubElement(box, "size").text = values(size)
    material = ET.SubElement(visual, "material")
    ET.SubElement(material, "ambient").text = values(color)
    ET.SubElement(material, "diffuse").text = values(color)


def generate(output_path):
    """Generate the rack using one rigid static link."""
    rack_width = (
        BAY_COUNT * BAY_CLEAR_WIDTH + (BAY_COUNT + 1) * POST_SIZE
    )
    bay_pitch = BAY_CLEAR_WIDTH + POST_SIZE
    first_post_y = -rack_width / 2 + POST_SIZE / 2
    post_x = RACK_DEPTH / 2 - POST_SIZE / 2

    sdf = ET.Element("sdf", version="1.9")
    model = ET.SubElement(sdf, "model", name="warehouse_rack_4x2_double")
    ET.SubElement(model, "static").text = "true"
    link = ET.SubElement(model, "link", name="rack_frame")

    # Five post lines form four 290 mm-clear bays on both rack faces.
    for column in range(BAY_COUNT + 1):
        y = first_post_y + column * bay_pitch
        for face_name, x in (("front", -post_x), ("rear", post_x)):
            add_box(
                link,
                f"{face_name}_post_{column + 1}",
                (x, y, RACK_HEIGHT / 2, 0, 0, 0),
                (POST_SIZE, POST_SIZE, RACK_HEIGHT),
                FRAME_COLOR,
            )

    # Bottom and top cross-members tie the two rows of posts together.
    for face_name, x in (("front", -post_x), ("rear", post_x)):
        add_box(
            link,
            f"{face_name}_bottom_crossbeam",
            (x, 0, POST_SIZE / 2, 0, 0, 0),
            (POST_SIZE, rack_width, POST_SIZE),
            FRAME_COLOR,
        )
        add_box(
            link,
            f"{face_name}_top_crossbeam",
            (x, 0, RACK_HEIGHT - POST_SIZE / 2, 0, 0, 0),
            (POST_SIZE, rack_width, POST_SIZE),
            FRAME_COLOR,
        )

    # Each pallet sits on two longitudinal rails aligned with its runners.
    # Rails are parallel to the forks, so no transverse beam blocks entry.
    for level_index, support_height in enumerate(SUPPORT_LEVELS, start=1):
        rail_z = support_height - RAIL_HEIGHT / 2
        for bay in range(BAY_COUNT):
            bay_center = (
                -rack_width / 2
                + POST_SIZE
                + BAY_CLEAR_WIDTH / 2
                + bay * bay_pitch
            )
            for side_name, offset in (
                ("left", PALLET_RUNNER_OFFSET),
                ("right", -PALLET_RUNNER_OFFSET),
            ):
                add_box(
                    link,
                    f"level_{level_index}_bay_{bay + 1}_{side_name}_rail",
                    (0, bay_center + offset, rail_z, 0, 0, 0),
                    (RAIL_LENGTH, RAIL_WIDTH, RAIL_HEIGHT),
                    RAIL_COLOR,
                )

    tree = ET.ElementTree(sdf)
    ET.indent(tree, space="  ")
    output_path.parent.mkdir(parents=True, exist_ok=True)
    tree.write(output_path, encoding="utf-8", xml_declaration=True)


if __name__ == "__main__":
    package_root = Path(__file__).resolve().parents[1]
    output = (
        package_root
        / "worlds"
        / "models"
        / "warehouse_rack_4x2_double"
        / "model.sdf"
    )
    generate(output)
    print(f"Generated {output}")
