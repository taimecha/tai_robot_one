#!/usr/bin/env python3

"""Convert the final ROS 2 Jazzy Twist command into ros2_control TwistStamped."""

import time

from geometry_msgs.msg import Twist, TwistStamped
import rclpy
from rclpy.node import Node


class CmdVelStamper(Node):
    """Stamp commands without replaying them so downstream timeouts stay valid."""

    def __init__(self):
        super().__init__('cmd_vel_stamper')
        self.declare_parameter('input_topic', '/cmd_vel')
        self.declare_parameter(
            'output_topic', '/base_controller/cmd_vel')
        self.declare_parameter('frame_id', 'base_footprint')
        self.declare_parameter('require_single_publisher', True)

        input_topic = str(self.get_parameter('input_topic').value)
        output_topic = str(self.get_parameter('output_topic').value)
        self.input_topic = input_topic
        self.frame_id = str(self.get_parameter('frame_id').value)
        self.require_single_publisher = bool(
            self.get_parameter('require_single_publisher').value)
        self.last_conflict_warning = 0.0

        self.publisher = self.create_publisher(
            TwistStamped, output_topic, 10)
        self.subscription = self.create_subscription(
            Twist, input_topic, self.command_callback, 10)

        self.get_logger().info(
            f'Converting {input_topic} (Twist) to '
            f'{output_topic} (TwistStamped)')

    def command_callback(self, command):
        if self.require_single_publisher:
            sources = self.get_publishers_info_by_topic(
                self.input_topic)
            if len(sources) != 1:
                now = time.monotonic()
                if now - self.last_conflict_warning >= 2.0:
                    self.last_conflict_warning = now
                    names = ', '.join(
                        f'{info.node_namespace.rstrip("/")}/{info.node_name}'
                        for info in sources)
                    self.get_logger().error(
                        'Rejected /cmd_vel because it has '
                        f'{len(sources)} publishers: {names}')
                command = Twist()
        stamped = TwistStamped()
        stamped.header.stamp = self.get_clock().now().to_msg()
        stamped.header.frame_id = self.frame_id
        stamped.twist = command
        self.publisher.publish(stamped)


def main(args=None):
    rclpy.init(args=args)
    node = CmdVelStamper()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
