#!/usr/bin/env python3

"""Apply Astra Pro depth validity without making close objects transparent.

Gazebo must render geometry closer than the real sensor's minimum range so an
opaque load still occludes the background.  This node turns those close depth
samples and cloud points into invalid measurements on the public ROS topics.
"""

from copy import copy

import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import (
    DurabilityPolicy,
    HistoryPolicy,
    qos_profile_sensor_data,
    QoSProfile,
    ReliabilityPolicy,
)
from sensor_msgs.msg import Image, PointCloud2, PointField


def filter_depth_image(message, min_depth, max_depth):
    """Return a copy with samples outside [min_depth, max_depth] invalid."""
    filtered = copy(message)
    data = bytearray(message.data)

    if message.height == 0 or message.width == 0:
        filtered.data = data
        return filtered

    if message.encoding == '32FC1':
        dtype = np.dtype('>f4' if message.is_bigendian else '<f4')
        depth = np.ndarray(
            shape=(message.height, message.width),
            dtype=dtype,
            buffer=data,
            strides=(message.step, dtype.itemsize),
        )
        invalid = (
            ~np.isfinite(depth)
            | (depth < min_depth)
            | (depth > max_depth)
        )
        depth[invalid] = np.nan
    elif message.encoding == '16UC1':
        dtype = np.dtype('>u2' if message.is_bigendian else '<u2')
        depth_mm = np.ndarray(
            shape=(message.height, message.width),
            dtype=dtype,
            buffer=data,
            strides=(message.step, dtype.itemsize),
        )
        min_depth_mm = int(round(min_depth * 1000.0))
        max_depth_mm = int(round(max_depth * 1000.0))
        invalid = (
            (depth_mm < min_depth_mm)
            | (depth_mm > max_depth_mm)
        )
        depth_mm[invalid] = 0
    else:
        raise ValueError(
            f'unsupported depth encoding {message.encoding!r}; '
            'expected 32FC1 or 16UC1')

    filtered.data = data
    return filtered


def _xyz_views(message, data):
    fields = {field.name: field for field in message.fields}
    missing = {'x', 'y', 'z'} - fields.keys()
    if missing:
        raise ValueError(
            f'point cloud is missing fields: {sorted(missing)}')

    for name in ('x', 'y', 'z'):
        if fields[name].datatype != PointField.FLOAT32:
            raise ValueError(f'point field {name!r} is not FLOAT32')

    dtype = np.dtype('>f4' if message.is_bigendian else '<f4')
    shape = (message.height, message.width)
    strides = (message.row_step, message.point_step)
    return tuple(
        np.ndarray(
            shape=shape,
            dtype=dtype,
            buffer=data,
            offset=fields[name].offset,
            strides=strides,
        )
        for name in ('x', 'y', 'z')
    )


def filter_point_cloud(message, min_depth, max_depth):
    """Invalidate points outside the Astra axial depth measurement range."""
    filtered = copy(message)
    data = bytearray(message.data)

    if message.height == 0 or message.width == 0:
        filtered.data = data
        filtered.is_dense = False
        return filtered

    x, y, z = _xyz_views(message, data)
    # Gazebo publishes this cloud in camera_link coordinates, whose +X axis is
    # the optical forward direction.  Astra's depth limit is axial depth, not
    # Euclidean range from the camera centre.
    invalid = (
        ~np.isfinite(x)
        | ~np.isfinite(y)
        | ~np.isfinite(z)
        | (x < min_depth)
        | (x > max_depth)
    )
    x[invalid] = np.nan
    y[invalid] = np.nan
    z[invalid] = np.nan

    filtered.data = data
    filtered.is_dense = False
    return filtered


class AstraSimRangeFilter(Node):
    """Publish Gazebo RGB-D data with the real Astra validity envelope."""

    def __init__(self):
        super().__init__('astra_sim_range_filter')
        self.declare_parameter('min_depth', 0.60)
        self.declare_parameter('max_depth', 8.00)
        self.declare_parameter(
            'raw_depth_topic', '/camera/sim_raw/depth_image')
        self.declare_parameter(
            'raw_points_topic', '/camera/sim_raw/points')
        self.declare_parameter('depth_topic', '/camera/depth_image')
        self.declare_parameter('points_topic', '/camera/points')

        self.min_depth = float(self.get_parameter('min_depth').value)
        self.max_depth = float(self.get_parameter('max_depth').value)
        if self.min_depth <= 0.0:
            raise ValueError('min_depth must be positive')
        if self.max_depth <= self.min_depth:
            raise ValueError('max_depth must be greater than min_depth')

        raw_depth_topic = str(
            self.get_parameter('raw_depth_topic').value)
        raw_points_topic = str(
            self.get_parameter('raw_points_topic').value)
        depth_topic = str(self.get_parameter('depth_topic').value)
        points_topic = str(self.get_parameter('points_topic').value)

        # RViz Image uses a reliable subscription, while Gazebo sensor inputs
        # are commonly best-effort.  A reliable publisher can serve both the
        # reliable RViz displays and best-effort Nav2 subscribers.
        output_qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=5,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.VOLATILE,
        )
        self.depth_publisher = self.create_publisher(
            Image, depth_topic, output_qos)
        self.points_publisher = self.create_publisher(
            PointCloud2, points_topic, output_qos)
        self.create_subscription(
            Image,
            raw_depth_topic,
            self.depth_callback,
            qos_profile_sensor_data,
        )
        self.create_subscription(
            PointCloud2,
            raw_points_topic,
            self.points_callback,
            qos_profile_sensor_data,
        )
        self.get_logger().info(
            f'Astra simulation range filter: valid depth '
            f'{self.min_depth:.2f}-{self.max_depth:.2f} m; '
            f'{raw_depth_topic} -> {depth_topic}, '
            f'{raw_points_topic} -> {points_topic}')

    def depth_callback(self, message):
        try:
            filtered = filter_depth_image(
                message, self.min_depth, self.max_depth)
        except (TypeError, ValueError) as error:
            self.get_logger().error(str(error), throttle_duration_sec=5.0)
            return
        self.depth_publisher.publish(filtered)

    def points_callback(self, message):
        try:
            filtered = filter_point_cloud(
                message, self.min_depth, self.max_depth)
        except (TypeError, ValueError) as error:
            self.get_logger().error(str(error), throttle_duration_sec=5.0)
            return
        self.points_publisher.publish(filtered)


def main(args=None):
    rclpy.init(args=args)
    node = AstraSimRangeFilter()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
