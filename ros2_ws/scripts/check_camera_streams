#!/usr/bin/env python3
"""Bounded read-only RGB/depth/obstacle-scan timing and synchronization check."""
import argparse
import json
from pathlib import Path
import time

import rclpy
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import CameraInfo, Image, LaserScan


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seconds', type=float, default=30.)
    parser.add_argument('--warmup', type=float, default=3.)
    parser.add_argument('--output', type=Path)
    args = parser.parse_args()
    if not 10 <= args.seconds <= 300 or not 1 <= args.warmup <= 30:
        parser.error('Use 10–300 measurement seconds and 1–30 warmup seconds')
    rclpy.init()
    node = rclpy.create_node('check_camera_streams')
    rows = {key: [] for key in ('rgb', 'depth', 'info', 'scan')}

    def callback(key):
        def receive(msg):
            stamp = msg.header.stamp.sec + msg.header.stamp.nanosec * 1e-9
            age = node.get_clock().now().nanoseconds * 1e-9 - stamp
            rows[key].append((time.monotonic(), stamp, age))
        return receive

    for key, kind, topic in (
        ('rgb', Image, '/camera/color/image_raw'),
        ('depth', Image, '/camera/depth/image_raw'),
        ('info', CameraInfo, '/camera/color/camera_info'),
        ('scan', LaserScan, '/camera/obstacle_scan'),
    ):
        node.create_subscription(kind, topic, callback(key), qos_profile_sensor_data)
    begin = time.monotonic() + args.warmup
    end = begin + args.seconds
    try:
        while time.monotonic() < end:
            rclpy.spin_once(node, timeout_sec=.02)
        rows = {key: [r for r in values if begin <= r[0] <= end]
                for key, values in rows.items()}
        streams = {}
        for key, values in rows.items():
            gaps = ([values[0][0] - begin, end - values[-1][0]] +
                    [b[0] - a[0] for a, b in zip(values, values[1:])]) if values else [args.seconds]
            ages = [r[2] for r in values]
            streams[key] = dict(samples=len(values), hz=len(values)/args.seconds,
                                max_gap_s=max(gaps), max_age_s=max(ages) if ages else None,
                                fresh_ratio=sum(-.05 <= age <= .25 for age in ages)/len(ages) if ages else 0.)
        depth_stamps = [r[1] for r in rows['depth']]
        info_stamps = [r[1] for r in rows['info']]
        matched = sum(
            min((abs(r[1]-s) for s in depth_stamps), default=float('inf')) <= .05 and
            min((abs(r[1]-s) for s in info_stamps), default=float('inf')) <= .05
            for r in rows['rgb'])
        pair_ratio = matched/len(rows['rgb']) if rows['rgb'] else 0.
        checks = dict(
            rgb_live=streams['rgb']['hz'] >= 10,
            depth_live=streams['depth']['hz'] >= 20,
            scan_live=streams['scan']['hz'] >= 10,
            no_large_gaps=all(s['max_gap_s'] <= .25 for s in streams.values()),
            fresh_data=all(s['fresh_ratio'] >= .98 for s in streams.values()),
            rgb_depth_info_synchronized=pair_ratio >= .98,
        )
        report = dict(scope='stationary stream timing only; no YOLO or motor commands',
                      duration_s=args.seconds, passed=all(checks.values()), checks=checks,
                      streams=streams, synchronized_rgb_frames=matched,
                      synchronized_rgb_ratio=pair_ratio)
        if args.output:
            args.output.parent.mkdir(parents=True, exist_ok=True)
            args.output.write_text(json.dumps(report, indent=2) + '\n')
        print(json.dumps(report, indent=2))
        return 0 if report['passed'] else 1
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    raise SystemExit(main())
