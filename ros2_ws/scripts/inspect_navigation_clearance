#!/usr/bin/env python3
"""Read-only costmap/TF capture and hypothetical-start planner probes. No motion."""
import argparse
import json
import math
import time
from pathlib import Path

import rclpy
from geometry_msgs.msg import PolygonStamped, PoseStamped
from nav2_msgs.msg import Costmap
from nav2_msgs.action import ComputePathToPose
from rclpy.action import ActionClient
from rclpy.qos import QoSProfile, DurabilityPolicy, ReliabilityPolicy
from rosidl_runtime_py.convert import message_to_ordereddict
from tf2_ros import Buffer, TransformListener


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', required=True)
    parser.add_argument('--goal', nargs=3, type=float, required=True, metavar=('X', 'Y', 'YAW'))
    parser.add_argument('--planners', nargs='+', choices=['GridBased', 'SE2Fallback'],
                        default=['GridBased', 'SE2Fallback'])
    parser.add_argument('--advances', nargs='+', type=float, default=[0.0, 0.15, 0.30, 0.45, 0.60])
    args = parser.parse_args()
    rclpy.init()
    node = rclpy.create_node('read_only_clearance_probe')
    data = {}
    qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL,
                     reliability=ReliabilityPolicy.RELIABLE)
    subscriptions = []
    for key, topic in [('global', '/global_costmap/costmap_raw'),
                       ('local', '/local_costmap/costmap_raw')]:
        subscriptions.append(node.create_subscription(
            Costmap, topic, lambda msg, k=key: data.__setitem__(k, msg), qos))
    subscriptions.append(node.create_subscription(
        PolygonStamped, '/local_costmap/published_footprint',
        lambda msg: data.__setitem__('footprint', msg), 1))
    buffer = Buffer()
    listener = TransformListener(buffer, node)
    deadline = time.monotonic() + 10
    robot = None
    while time.monotonic() < deadline:
        rclpy.spin_once(node, timeout_sec=0.1)
        try:
            robot = buffer.lookup_transform('map', 'base_footprint', rclpy.time.Time())
            if len(data) == 3:
                break
        except Exception:
            pass
    if len(data) != 3 or robot is None:
        raise RuntimeError('Cannot capture current global/local costmaps, footprint and TF')
    captured = dict(data)
    deadline = time.monotonic() + 3
    while time.monotonic() < deadline:
        rclpy.spin_once(node, timeout_sec=0.1)
        try:
            body_tf = buffer.lookup_transform(
                'base_footprint', captured['footprint'].header.frame_id,
                rclpy.time.Time.from_msg(captured['footprint'].header.stamp))
            break
        except Exception:
            pass
    else:
        raise RuntimeError('Footprint timestamp has no matching TF')
    robot = buffer.lookup_transform('map', 'base_footprint', rclpy.time.Time())
    local_tf = buffer.lookup_transform('odom', 'map', rclpy.time.Time())
    q = robot.transform.rotation
    yaw = math.atan2(2 * (q.w*q.z + q.x*q.y), 1 - 2*(q.y*q.y + q.z*q.z))
    x, y = robot.transform.translation.x, robot.transform.translation.y
    print(f'Current robot: x={x:.4f}, y={y:.4f}, yaw={math.degrees(yaw):.2f} deg', flush=True)
    snapshot = {k: message_to_ordereddict(v) for k, v in captured.items()}
    snapshot.update(robot=message_to_ordereddict(robot),
                    map_to_local=message_to_ordereddict(local_tf),
                    footprint_to_base=message_to_ordereddict(body_tf),
                    requested_goal=args.goal, probes=[])
    client = ActionClient(node, ComputePathToPose, '/compute_path_to_pose')
    if not client.wait_for_server(timeout_sec=3):
        raise RuntimeError('Planner action server unavailable')
    for advance in args.advances:
        for planner in args.planners:
            request = ComputePathToPose.Goal()
            request.use_start = True
            request.planner_id = planner
            request.start = PoseStamped()
            request.start.header.frame_id = 'map'
            request.start.pose.position.x = x + advance * math.cos(yaw)
            request.start.pose.position.y = y + advance * math.sin(yaw)
            request.start.pose.orientation.z = math.sin(yaw/2)
            request.start.pose.orientation.w = math.cos(yaw/2)
            request.goal.header.frame_id = 'map'
            request.goal.pose.position.x, request.goal.pose.position.y = args.goal[:2]
            request.goal.pose.orientation.z = math.sin(args.goal[2]/2)
            request.goal.pose.orientation.w = math.cos(args.goal[2]/2)
            future = client.send_goal_async(request)
            rclpy.spin_until_future_complete(node, future, timeout_sec=5)
            if not future.done() or not future.result().accepted:
                raise RuntimeError('Planner request not accepted')
            result_future = future.result().get_result_async()
            rclpy.spin_until_future_complete(node, result_future, timeout_sec=8)
            if not result_future.done():
                future.result().cancel_goal_async()
                raise RuntimeError('Planner-only probe timed out')
            result = result_future.result().result
            print(f'advance={advance:.2f} planner={planner}: '
                  f'error={result.error_code} poses={len(result.path.poses)} '
                  f'{result.error_msg}', flush=True)
            snapshot['probes'].append(dict(
                advance=advance, planner=planner, error=result.error_code,
                path=message_to_ordereddict(result.path)))
    Path(args.output).write_text(json.dumps(snapshot))
    print(f'Snapshot saved: {args.output}', flush=True)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
