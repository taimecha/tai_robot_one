#!/usr/bin/env python3

"""Render live IMU data as oriented RGB axes and text in RViz."""

import math

from geometry_msgs.msg import Quaternion
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from nav_msgs.msg import Odometry
from sensor_msgs.msg import Imu
from visualization_msgs.msg import Marker, MarkerArray


def euler_degrees(orientation):
    """Return REP-103 roll, pitch and yaw in degrees."""
    sin_roll = 2.0 * (
        orientation.w * orientation.x
        + orientation.y * orientation.z)
    cos_roll = 1.0 - 2.0 * (
        orientation.x * orientation.x
        + orientation.y * orientation.y)
    roll = math.atan2(sin_roll, cos_roll)

    sin_pitch = 2.0 * (
        orientation.w * orientation.y
        - orientation.z * orientation.x)
    pitch = math.asin(max(-1.0, min(1.0, sin_pitch)))

    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y)
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z)
    yaw = math.atan2(sin_yaw, cos_yaw)
    return tuple(math.degrees(angle) for angle in (roll, pitch, yaw))


def roll_pitch_quaternion(roll_degrees, pitch_degrees):
    """Return tilt only; base_footprint TF already supplies the vehicle yaw."""
    half_roll = math.radians(roll_degrees) * 0.5
    half_pitch = math.radians(pitch_degrees) * 0.5
    cr, sr = math.cos(half_roll), math.sin(half_roll)
    cp, sp = math.cos(half_pitch), math.sin(half_pitch)
    result = Quaternion()
    result.x = sr * cp
    result.y = cr * sp
    result.z = -sr * sp
    result.w = cr * cp
    return result


class ImuVisualizer(Node):
    """Show sensor attitude and numeric values without an RViz IMU plugin."""

    def __init__(self):
        super().__init__('imu_visualizer')
        self.declare_parameter('publish_rate', 10.0)
        publish_rate = float(self.get_parameter('publish_rate').value)
        if publish_rate <= 0.0:
            raise ValueError('publish_rate must be positive')
        self.latest_message = None
        self.latest_wheel_odom = None
        self.latest_ekf_odom = None
        self.yaw_origins = None
        self.marker_publisher = self.create_publisher(
            MarkerArray, '/imu/markers', 10)
        self.create_subscription(
            Imu, '/imu', self.imu_callback, qos_profile_sensor_data)
        self.create_subscription(
            Odometry, '/base_controller/odom',
            self.wheel_odom_callback, 10)
        self.create_subscription(
            Odometry, '/odom', self.ekf_odom_callback, 10)
        self.create_timer(1.0 / publish_rate, self.publish_latest)

    @staticmethod
    def valid_orientation(orientation):
        norm = math.sqrt(
            orientation.x * orientation.x
            + orientation.y * orientation.y
            + orientation.z * orientation.z
            + orientation.w * orientation.w)
        if norm < 1e-9:
            identity = Quaternion()
            identity.w = 1.0
            return identity
        normalized = Quaternion()
        normalized.x = orientation.x / norm
        normalized.y = orientation.y / norm
        normalized.z = orientation.z / norm
        normalized.w = orientation.w / norm
        return normalized

    @staticmethod
    def axis_rotation(axis):
        rotation = Quaternion()
        if axis == 'x':
            rotation.w = 1.0
        elif axis == 'y':
            rotation.z = math.sin(math.pi / 4.0)
            rotation.w = math.cos(math.pi / 4.0)
        else:
            rotation.y = -math.sin(math.pi / 4.0)
            rotation.w = math.cos(math.pi / 4.0)
        return rotation

    @staticmethod
    def multiply_quaternions(left, right):
        """Compose two geometry_msgs quaternions."""
        result = Quaternion()
        result.w = (
            left.w * right.w - left.x * right.x
            - left.y * right.y - left.z * right.z)
        result.x = (
            left.w * right.x + left.x * right.w
            + left.y * right.z - left.z * right.y)
        result.y = (
            left.w * right.y - left.x * right.z
            + left.y * right.w + left.z * right.x)
        result.z = (
            left.w * right.z + left.x * right.y
            - left.y * right.x + left.z * right.w)
        return result

    def base_marker(self, message, marker_id, marker_type):
        marker = Marker()
        # Attaching markers to the robot avoids a high-rate /odom subscription.
        # A zero timestamp asks RViz for the newest available transform. Gazebo
        # publishes IMU and TF on separate sensor cycles, so copying the exact
        # IMU timestamp can intermittently put the marker a few milliseconds
        # ahead of the TF buffer and make RViz flash Error / OK.
        marker.header.frame_id = 'base_footprint'
        marker.frame_locked = True
        marker.ns = 'live_imu'
        marker.id = marker_id
        marker.type = marker_type
        marker.action = Marker.ADD
        marker.pose.position.z = 0.55
        return marker

    def imu_callback(self, message):
        """Keep only the newest sample; the display has its own exact timer."""
        self.latest_message = message

    def wheel_odom_callback(self, message):
        """Keep the latest encoder-only odometry sample."""
        self.latest_wheel_odom = message

    def ekf_odom_callback(self, message):
        """Keep the latest filtered odometry sample."""
        self.latest_ekf_odom = message

    @staticmethod
    def yaw_quaternion(yaw_degrees):
        """Return a planar quaternion for a yaw angle in degrees."""
        result = Quaternion()
        half_yaw = math.radians(yaw_degrees) * 0.5
        result.z = math.sin(half_yaw)
        result.w = math.cos(half_yaw)
        return result

    @staticmethod
    def relative_degrees(value, origin):
        """Return the wrapped heading change from origin in [-180, 180)."""
        return (value - origin + 180.0) % 360.0 - 180.0

    def publish_latest(self):
        """Publish RViz markers at the configured rate, independent of IMU Hz."""
        if self.latest_message is None:
            return
        message = self.latest_message

        if self.latest_wheel_odom is None or self.latest_ekf_odom is None:
            return

        imu_yaw = euler_degrees(
            self.valid_orientation(message.orientation))[2]
        wheel_yaw = euler_degrees(self.valid_orientation(
            self.latest_wheel_odom.pose.pose.orientation))[2]
        ekf_yaw = euler_degrees(self.valid_orientation(
            self.latest_ekf_odom.pose.pose.orientation))[2]
        if self.yaw_origins is None:
            self.yaw_origins = (imu_yaw, ekf_yaw, wheel_yaw)
        imu_yaw = self.relative_degrees(imu_yaw, self.yaw_origins[0])
        ekf_yaw = self.relative_degrees(ekf_yaw, self.yaw_origins[1])
        wheel_yaw = self.relative_degrees(wheel_yaw, self.yaw_origins[2])
        markers = MarkerArray()

        # Markers are attached to the EKF-driven base_footprint frame. Rotate
        # IMU and wheel arrows by their difference from EKF so all three arrows
        # represent their headings in the same odom view without double yaw.
        sources = (
            ('IMU', imu_yaw, +0.24, (1.0, 0.1, 0.35)),
            ('EKF', ekf_yaw, 0.00, (0.0, 0.55, 1.0)),
            ('ENC', wheel_yaw, -0.24, (1.0, 0.75, 0.0)),
        )
        for marker_id, (label, yaw, lateral, color) in enumerate(sources):
            marker = self.base_marker(message, marker_id, Marker.ARROW)
            marker.pose.position.y = lateral
            marker.pose.orientation = self.yaw_quaternion(yaw - ekf_yaw)
            marker.scale.x = 0.48
            marker.scale.y = 0.055
            marker.scale.z = 0.055
            marker.color.r, marker.color.g, marker.color.b = color
            marker.color.a = 1.0
            markers.markers.append(marker)

            text = self.base_marker(
                message, marker_id + len(sources), Marker.TEXT_VIEW_FACING)
            # Keep the complete label in a clear column to the left of the
            # robot. Centering it near x=0 makes the numeric half overlap the
            # corresponding arrow and becomes unreadable in top-down view.
            text.pose.position.x = -0.72
            text.pose.position.y = lateral
            text.pose.position.z += 0.11
            text.pose.orientation.w = 1.0
            text.scale.z = 0.070
            text.color.r, text.color.g, text.color.b = color
            text.color.a = 1.0
            text.text = f'{label} {yaw:+.2f}°'
            markers.markers.append(text)
        self.marker_publisher.publish(markers)


def main(args=None):
    rclpy.init(args=args)
    node = ImuVisualizer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
