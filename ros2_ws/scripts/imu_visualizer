#!/usr/bin/env python3

"""Render live IMU data as oriented RGB axes and text in RViz."""

import math

from geometry_msgs.msg import Quaternion
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import Imu
from visualization_msgs.msg import Marker, MarkerArray


def euler_degrees(orientation):
    """Return REP-103 roll, pitch and yaw in degrees."""
    sin_roll = 2.0 * (
        orientation.w * orientation.x
        + orientation.y * orientation.z)
    cos_roll = 1.0 - 2.0 * (
        orientation.x * orientation.x
        + orientation.y * orientation.y)
    roll = math.atan2(sin_roll, cos_roll)

    sin_pitch = 2.0 * (
        orientation.w * orientation.y
        - orientation.z * orientation.x)
    pitch = math.asin(max(-1.0, min(1.0, sin_pitch)))

    sin_yaw = 2.0 * (
        orientation.w * orientation.z
        + orientation.x * orientation.y)
    cos_yaw = 1.0 - 2.0 * (
        orientation.y * orientation.y
        + orientation.z * orientation.z)
    yaw = math.atan2(sin_yaw, cos_yaw)
    return tuple(math.degrees(angle) for angle in (roll, pitch, yaw))


def roll_pitch_quaternion(roll_degrees, pitch_degrees):
    """Return tilt only; base_footprint TF already supplies the vehicle yaw."""
    half_roll = math.radians(roll_degrees) * 0.5
    half_pitch = math.radians(pitch_degrees) * 0.5
    cr, sr = math.cos(half_roll), math.sin(half_roll)
    cp, sp = math.cos(half_pitch), math.sin(half_pitch)
    result = Quaternion()
    result.x = sr * cp
    result.y = cr * sp
    result.z = -sr * sp
    result.w = cr * cp
    return result


class ImuVisualizer(Node):
    """Show sensor attitude and numeric values without an RViz IMU plugin."""

    def __init__(self):
        super().__init__('imu_visualizer')
        self.declare_parameter('publish_rate', 10.0)
        publish_rate = float(self.get_parameter('publish_rate').value)
        if publish_rate <= 0.0:
            raise ValueError('publish_rate must be positive')
        self.latest_message = None
        self.marker_publisher = self.create_publisher(
            MarkerArray, '/imu/markers', 10)
        self.create_subscription(
            Imu, '/imu', self.imu_callback, qos_profile_sensor_data)
        self.create_timer(1.0 / publish_rate, self.publish_latest)

    @staticmethod
    def valid_orientation(orientation):
        norm = math.sqrt(
            orientation.x * orientation.x
            + orientation.y * orientation.y
            + orientation.z * orientation.z
            + orientation.w * orientation.w)
        if norm < 1e-9:
            identity = Quaternion()
            identity.w = 1.0
            return identity
        normalized = Quaternion()
        normalized.x = orientation.x / norm
        normalized.y = orientation.y / norm
        normalized.z = orientation.z / norm
        normalized.w = orientation.w / norm
        return normalized

    @staticmethod
    def axis_rotation(axis):
        rotation = Quaternion()
        if axis == 'x':
            rotation.w = 1.0
        elif axis == 'y':
            rotation.z = math.sin(math.pi / 4.0)
            rotation.w = math.cos(math.pi / 4.0)
        else:
            rotation.y = -math.sin(math.pi / 4.0)
            rotation.w = math.cos(math.pi / 4.0)
        return rotation

    @staticmethod
    def multiply_quaternions(left, right):
        """Compose two geometry_msgs quaternions."""
        result = Quaternion()
        result.w = (
            left.w * right.w - left.x * right.x
            - left.y * right.y - left.z * right.z)
        result.x = (
            left.w * right.x + left.x * right.w
            + left.y * right.z - left.z * right.y)
        result.y = (
            left.w * right.y - left.x * right.z
            + left.y * right.w + left.z * right.x)
        result.z = (
            left.w * right.z + left.x * right.y
            - left.y * right.x + left.z * right.w)
        return result

    def base_marker(self, message, marker_id, marker_type):
        marker = Marker()
        # Attaching markers to the robot avoids a high-rate /odom subscription.
        # A zero timestamp asks RViz for the newest available transform. Gazebo
        # publishes IMU and TF on separate sensor cycles, so copying the exact
        # IMU timestamp can intermittently put the marker a few milliseconds
        # ahead of the TF buffer and make RViz flash Error / OK.
        marker.header.frame_id = 'base_footprint'
        marker.frame_locked = True
        marker.ns = 'live_imu'
        marker.id = marker_id
        marker.type = marker_type
        marker.action = Marker.ADD
        marker.pose.position.z = 0.55
        return marker

    def imu_callback(self, message):
        """Keep only the newest sample; the display has its own exact timer."""
        self.latest_message = message

    def publish_latest(self):
        """Publish RViz markers at the configured rate, independent of IMU Hz."""
        if self.latest_message is None:
            return
        message = self.latest_message

        orientation = self.valid_orientation(message.orientation)
        roll, pitch, yaw = euler_degrees(orientation)
        # Markers live in base_footprint, whose TF already contains the fused
        # vehicle yaw. Applying the absolute IMU yaw here would rotate the axes
        # twice in RViz (90 degrees of travel would be rendered as 180). Keep
        # the measured tilt for the live axes and show yaw numerically below.
        marker_tilt = roll_pitch_quaternion(roll, pitch)
        markers = MarkerArray()
        colors = {
            'x': (1.0, 0.1, 0.1),
            'y': (0.1, 1.0, 0.1),
            'z': (0.1, 0.35, 1.0),
        }

        for marker_id, axis in enumerate(('x', 'y', 'z')):
            marker = self.base_marker(message, marker_id, Marker.ARROW)
            marker.pose.orientation = self.multiply_quaternions(
                marker_tilt, self.axis_rotation(axis))
            marker.scale.x = 0.24
            marker.scale.y = 0.025
            marker.scale.z = 0.040
            marker.color.r, marker.color.g, marker.color.b = colors[axis]
            marker.color.a = 1.0
            markers.markers.append(marker)

        text = self.base_marker(message, 3, Marker.TEXT_VIEW_FACING)
        text.pose.position.z += 0.28
        text.pose.orientation.w = 1.0
        text.scale.z = 0.075
        text.color.r = 1.0
        text.color.g = 1.0
        text.color.b = 1.0
        text.color.a = 1.0
        text.text = (
            'IMU /imu\n'
            f'Roll={roll:+.1f}°  Pitch={pitch:+.1f}°  Yaw={yaw:+.1f}°\n'
            f'wz={message.angular_velocity.z:+.3f} rad/s  '
            f'a=({message.linear_acceleration.x:+.2f}, '
            f'{message.linear_acceleration.y:+.2f}, '
            f'{message.linear_acceleration.z:+.2f}) m/s²')
        markers.markers.append(text)
        self.marker_publisher.publish(markers)


def main(args=None):
    rclpy.init(args=args)
    node = ImuVisualizer()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
