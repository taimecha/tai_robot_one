#!/usr/bin/env python3

"""Publish a safe, repeating joint-motion sequence for URDF/RViz testing."""

import math

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState


class RobotMotionTester(Node):
    """Exercise four continuous wheel joints and the bounded lift joint."""

    WHEEL_JOINTS = (
        'front_left_wheel_joint',
        'front_right_wheel_joint',
        'rear_left_wheel_joint',
        'rear_right_wheel_joint',
    )
    LIFT_JOINT = 'lift_joint'

    def __init__(self):
        super().__init__('robot_motion_tester')

        self.declare_parameter('update_rate', 50.0)
        self.declare_parameter('wheel_speed', 2.0)
        # Matches the velocity limit declared on lift_joint in the URDF.
        self.declare_parameter('lift_speed', 0.05)
        self.declare_parameter('lift_lower_limit', 0.0)
        self.declare_parameter('lift_upper_limit', 0.52)

        self.update_rate = float(self.get_parameter('update_rate').value)
        self.wheel_speed = float(self.get_parameter('wheel_speed').value)
        self.lift_speed = float(self.get_parameter('lift_speed').value)
        self.lift_lower = float(self.get_parameter('lift_lower_limit').value)
        self.lift_upper = float(self.get_parameter('lift_upper_limit').value)

        if self.update_rate <= 0.0:
            raise ValueError('update_rate must be greater than zero')
        if self.wheel_speed <= 0.0:
            raise ValueError('wheel_speed must be greater than zero')
        if not 0.0 < self.lift_speed <= 0.05:
            raise ValueError(
                'lift_speed must be greater than zero and at most 0.05 m/s')
        if not 0.0 <= self.lift_lower < self.lift_upper <= 0.52:
            raise ValueError(
                'lift limits must satisfy 0.0 <= lower < upper <= 0.52 m')

        self.publisher = self.create_publisher(JointState, '/joint_states', 10)
        self.dt = 1.0 / self.update_rate
        self.wheel_positions = [0.0, 0.0, 0.0, 0.0]
        self.lift_position = self.lift_lower

        lift_duration = (self.lift_upper - self.lift_lower) / self.lift_speed
        stop = (0.0, 0.0, 0.0, 0.0)
        speed = self.wheel_speed

        # name, duration [s], four wheel velocities [rad/s], lift velocity [m/s]
        self.phases = (
            ('front-left wheel', 2.0, (speed, 0.0, 0.0, 0.0), 0.0),
            ('front-right wheel', 2.0, (0.0, speed, 0.0, 0.0), 0.0),
            ('rear-left wheel', 2.0, (0.0, 0.0, speed, 0.0), 0.0),
            ('rear-right wheel', 2.0, (0.0, 0.0, 0.0, speed), 0.0),
            ('all wheels forward', 3.0, (speed, speed, speed, speed), 0.0),
            ('skid-steer rotation', 3.0, (-speed, speed, -speed, speed), 0.0),
            ('lift upward', lift_duration, stop, self.lift_speed),
            ('lift downward', lift_duration, stop, -self.lift_speed),
            ('pause', 1.0, stop, 0.0),
        )

        self.phase_index = 0
        self.phase_elapsed = 0.0
        self.get_logger().info(
            'RViz motion test started. Lift is clamped to '
            f'[{self.lift_lower:.3f}, {self.lift_upper:.3f}] m.')
        self._log_phase()
        self.timer = self.create_timer(self.dt, self._timer_callback)

    def _log_phase(self):
        name = self.phases[self.phase_index][0]
        self.get_logger().info(f'Testing: {name}')

    def _timer_callback(self):
        name, duration, wheel_velocities, lift_velocity = self.phases[
            self.phase_index]

        for index, velocity in enumerate(wheel_velocities):
            self.wheel_positions[index] = math.fmod(
                self.wheel_positions[index] + velocity * self.dt,
                2.0 * math.pi)

        self.lift_position += lift_velocity * self.dt
        self.lift_position = min(
            self.lift_upper, max(self.lift_lower, self.lift_position))

        message = JointState()
        message.header.stamp = self.get_clock().now().to_msg()
        message.name = list(self.WHEEL_JOINTS) + [self.LIFT_JOINT]
        message.position = self.wheel_positions + [self.lift_position]
        message.velocity = list(wheel_velocities) + [lift_velocity]
        self.publisher.publish(message)

        self.phase_elapsed += self.dt
        if self.phase_elapsed + 1e-9 < duration:
            return

        if name == 'lift upward':
            self.lift_position = self.lift_upper
        elif name == 'lift downward':
            self.lift_position = self.lift_lower

        self.phase_index = (self.phase_index + 1) % len(self.phases)
        self.phase_elapsed = 0.0
        self._log_phase()


def main(args=None):
    rclpy.init(args=args)
    node = RobotMotionTester()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        # ROS launch may already have shut the context down after SIGINT.
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
