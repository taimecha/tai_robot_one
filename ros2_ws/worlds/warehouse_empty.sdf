<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="warehouse_physics" type="dart">
      <!-- 200 Hz is sufficient for this slow mobile robot while leaving more
           CPU time for the RGB-D sensor and RViz under WSL. -->
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- DART defaults to the ODE collision detector, which cannot service
           gz-sim RaycastData. Bullet supports those CPU-side ray queries and
           keeps LiDAR independent from the WSL rendering backend. -->
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <!-- Ogre1 keeps the RGB-D stream stable while the robot rotates under
           WSL / D3D12.  LiDAR uses the independent physics-raycast plugin and
           therefore no longer depends on this rendering backend. -->
      <render_engine>ogre</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Use a deterministic startup view instead of restoring a stale camera
         aimed only at the rack. This view contains the robot at (0, 0) and
         the rack at (2, 0). -->
    <gui fullscreen="false">
      <plugin name="3D View" filename="GzScene3D">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <camera_pose>-3.5 -3.5 3.0 0 0.45 0.75</camera_pose>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Physical warehouse boundary, kept as collision geometry for mapping. -->
    <model name="warehouse_walls">
      <static>true</static>
      <link name="walls_link">
        <collision name="west_wall_collision">
          <pose>-2.5 1.0 0.75 0 0 0</pose>
          <geometry><box><size>0.05 7.0 1.5</size></box></geometry>
        </collision>
        <visual name="west_wall_visual">
          <pose>-2.5 1.0 0.75 0 0 0</pose>
          <geometry><box><size>0.05 7.0 1.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
        <collision name="east_wall_collision">
          <pose>4.5 1.0 0.75 0 0 0</pose>
          <geometry><box><size>0.05 7.0 1.5</size></box></geometry>
        </collision>
        <visual name="east_wall_visual">
          <pose>4.5 1.0 0.75 0 0 0</pose>
          <geometry><box><size>0.05 7.0 1.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
        <collision name="south_wall_collision">
          <pose>1.0 -2.5 0.75 0 0 0</pose>
          <geometry><box><size>7.0 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="south_wall_visual">
          <pose>1.0 -2.5 0.75 0 0 0</pose>
          <geometry><box><size>7.0 0.05 1.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
        <collision name="north_wall_collision">
          <pose>1.0 4.5 0.75 0 0 0</pose>
          <geometry><box><size>7.0 0.05 1.5</size></box></geometry>
        </collision>
        <visual name="north_wall_visual">
          <pose>1.0 4.5 0.75 0 0 0</pose>
          <geometry><box><size>7.0 0.05 1.5</size></box></geometry>
          <material>
            <ambient>0.72 0.74 0.76 1</ambient>
            <diffuse>0.82 0.84 0.86 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Three small physical test obstacles, 0.90 m high: 0.10 m above the
      lidar scan plane. They are offset from the centre aisle so they do not
      obstruct pallet pickup, but still produce visible /scan returns.
    -->
    <model name="lidar_test_obstacles">
      <static>true</static>
      <link name="obstacles_link">
        <collision name="left_rear_obstacle_collision">
          <pose>-0.8 1.0 0.45 0 0 0</pose>
          <geometry><box><size>0.18 0.18 0.90</size></box></geometry>
        </collision>
        <visual name="left_rear_obstacle_visual">
          <pose>-0.8 1.0 0.45 0 0 0</pose>
          <geometry><box><size>0.18 0.18 0.90</size></box></geometry>
          <material>
            <ambient>0.85 0.32 0.05 1</ambient>
            <diffuse>0.95 0.42 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="right_side_obstacle_collision">
          <pose>0.3 -1.1 0.45 0 0 0</pose>
          <geometry><box><size>0.22 0.22 0.90</size></box></geometry>
        </collision>
        <visual name="right_side_obstacle_visual">
          <pose>0.3 -1.1 0.45 0 0 0</pose>
          <geometry><box><size>0.22 0.22 0.90</size></box></geometry>
          <material>
            <ambient>0.85 0.32 0.05 1</ambient>
            <diffuse>0.95 0.42 0.08 1</diffuse>
          </material>
        </visual>
        <collision name="rack_side_obstacle_collision">
          <pose>1.1 1.25 0.45 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.90</size></box></geometry>
        </collision>
        <visual name="rack_side_obstacle_visual">
          <pose>1.1 1.25 0.45 0 0 0</pose>
          <geometry><box><size>0.25 0.25 0.90</size></box></geometry>
          <material>
            <ambient>0.85 0.32 0.05 1</ambient>
            <diffuse>0.95 0.42 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      The rack is 4 bays x 2 levels x 2 faces = 16 storage positions.
      Front-face pallet centres are at x=1.795 m and rear-face centres are at
      x=2.205 m. The 90 and 370 mm support levels correspond to nominal lift
      joint positions of about 30 and 310 mm for the robot's 65 mm minimum
      fork height.
    -->
    <include>
      <uri>model://warehouse_rack_4x2_double</uri>
      <name>warehouse_rack</name>
      <pose>2.0 0 0 0 0 0</pose>
    </include>

    <!-- Front face: aisle is on the negative-X side of the rack. -->
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l1_c1</name>
      <pose>1.795 -0.480 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l1_c2</name>
      <pose>1.795 -0.160 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l1_c3</name>
      <pose>1.795 0.160 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l1_c4</name>
      <pose>1.795 0.480 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l2_c1</name>
      <pose>1.795 -0.480 0.371 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l2_c2</name>
      <pose>1.795 -0.160 0.371 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l2_c3</name>
      <pose>1.795 0.160 0.371 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_front_l2_c4</name>
      <pose>1.795 0.480 0.371 0 0 0</pose>
    </include>

    <!-- Rear face: aisle is on the positive-X side of the rack. -->
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l1_c1</name>
      <pose>2.205 -0.480 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l1_c2</name>
      <pose>2.205 -0.160 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l1_c3</name>
      <pose>2.205 0.160 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l1_c4</name>
      <pose>2.205 0.480 0.091 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l2_c1</name>
      <pose>2.205 -0.480 0.371 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l2_c2</name>
      <pose>2.205 -0.160 0.371 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l2_c3</name>
      <pose>2.205 0.160 0.371 0 0 0</pose>
    </include>
    <include>
      <uri>model://warehouse_pallet_box</uri>
      <name>pallet_rear_l2_c4</name>
      <pose>2.205 0.480 0.371 0 0 0</pose>
    </include>
  </world>
</sdf>
