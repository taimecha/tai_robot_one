<?xml version="1.0"?>
<sdf version="1.9">
  <model name="warehouse_pallet_box">
    <static>false</static>
    <allow_auto_disable>true</allow_auto_disable>

    <!--
      Pallet axes:
        X: fork insertion direction (340 mm)
        Y: across the fork pair (250 mm)
        Z: up

      The two 30 mm runners leave a 190 mm-wide centre tunnel. The robot's
      155 mm fork-pair envelope therefore has 17.5 mm lateral clearance per
      side. The 25 mm tunnel height clears the 8 mm-thick forks.

      The simulated load is 5 kg and the pallet is 1 kg. Replace these
      values and the inertia tensor after weighing the real payload.
    -->
    <link name="loaded_pallet">
      <inertial>
        <pose>0 0 0.145 0 0 0</pose>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.0638</ixx>
          <iyy>0.0903</iyy>
          <izz>0.0891</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- 10 mm deck, from z=25 to z=35 mm. -->
      <collision name="pallet_deck_collision">
        <pose>0 0 0.030 0 0 0</pose>
        <geometry>
          <box><size>0.340 0.250 0.010</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="pallet_deck_visual">
        <pose>0 0 0.030 0 0 0</pose>
        <geometry>
          <box><size>0.340 0.250 0.010</size></box>
        </geometry>
        <material>
          <ambient>0.55 0.32 0.12 1</ambient>
          <diffuse>0.66 0.40 0.17 1</diffuse>
        </material>
      </visual>

      <!-- 25 mm runners at the outer edges; inner faces are y=+/-95 mm. -->
      <collision name="left_runner_collision">
        <pose>0 0.110 0.0125 0 0 0</pose>
        <geometry>
          <box><size>0.340 0.030 0.025</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_runner_visual">
        <pose>0 0.110 0.0125 0 0 0</pose>
        <geometry>
          <box><size>0.340 0.030 0.025</size></box>
        </geometry>
        <material>
          <ambient>0.48 0.27 0.10 1</ambient>
          <diffuse>0.58 0.34 0.14 1</diffuse>
        </material>
      </visual>
      <collision name="right_runner_collision">
        <pose>0 -0.110 0.0125 0 0 0</pose>
        <geometry>
          <box><size>0.340 0.030 0.025</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_runner_visual">
        <pose>0 -0.110 0.0125 0 0 0</pose>
        <geometry>
          <box><size>0.340 0.030 0.025</size></box>
        </geometry>
        <material>
          <ambient>0.48 0.27 0.10 1</ambient>
          <diffuse>0.58 0.34 0.14 1</diffuse>
        </material>
      </visual>

      <!-- Cargo: 310 mm deep, 220 mm wide and 220 mm high. -->
      <collision name="box_collision">
        <pose>0 0 0.145 0 0 0</pose>
        <geometry>
          <box><size>0.310 0.220 0.220</size></box>
        </geometry>
        <surface>
          <friction>
            <ode><mu>0.7</mu><mu2>0.7</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="box_visual">
        <pose>0 0 0.145 0 0 0</pose>
        <geometry>
          <box><size>0.310 0.220 0.220</size></box>
        </geometry>
        <material>
          <ambient>0.70 0.50 0.25 1</ambient>
          <diffuse>0.82 0.60 0.31 1</diffuse>
        </material>
      </visual>

      <!-- Dark bands make the box orientation visible from both aisles. -->
      <visual name="box_front_band_visual">
        <pose>-0.1551 0 0.145 0 0 0</pose>
        <geometry>
          <box><size>0.001 0.030 0.220</size></box>
        </geometry>
        <material>
          <ambient>0.24 0.14 0.06 1</ambient>
          <diffuse>0.30 0.18 0.08 1</diffuse>
        </material>
      </visual>
      <visual name="box_back_band_visual">
        <pose>0.1551 0 0.145 0 0 0</pose>
        <geometry>
          <box><size>0.001 0.030 0.220</size></box>
        </geometry>
        <material>
          <ambient>0.24 0.14 0.06 1</ambient>
          <diffuse>0.30 0.18 0.08 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
