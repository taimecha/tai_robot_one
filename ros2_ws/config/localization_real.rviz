Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 30
    - Class: rviz_default_plugins/Map
      Name: Saved Map
      Enabled: true
      Alpha: 0.7
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Scheme: map
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/LaserScan
      Name: Filtered Lidar
      Enabled: true
      Topic:
        Value: /scan_filtered
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
        Filter size: 30
      Style: Points
      Size (Pixels): 3
      Size (m): 0.02
      Alpha: 1
      Decay Time: 0
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 80; 30
      Use Fixed Frame: true
    - Class: nav2_rviz_plugins/ParticleCloud
      Name: AMCL Particles
      Enabled: true
      Topic:
        Value: /particle_cloud
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Color: 0; 180; 0
      Shape: Arrow (Flat)
      Min Arrow Length: 0.02
      Max Arrow Length: 0.15
    - Class: rviz_default_plugins/Odometry
      Name: Wheel odom (raw)
      Enabled: false
      Topic:
        Value: /base_controller/odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Shape:
        Value: Arrow
        Color: 255; 190; 0
        Alpha: 1
        Shaft Length: 0.35
        Shaft Radius: 0.025
        Head Length: 0.12
        Head Radius: 0.06
      Keep: 100
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
    - Class: rviz_default_plugins/Odometry
      Name: EKF odom (/odom)
      Enabled: false
      Topic:
        Value: /odom
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
      Shape:
        Value: Arrow
        Color: 0; 170; 255
        Alpha: 1
        Shaft Length: 0.45
        Shaft Radius: 0.035
        Head Length: 0.14
        Head Radius: 0.075
      Keep: 100
      Position Tolerance: 0.01
      Angle Tolerance: 0.01
    - Class: rviz_default_plugins/MarkerArray
      Name: IMU (/imu via markers)
      Enabled: false
      Namespaces:
        live_imu: true
      Queue Size: 10
      Topic:
        Value: /imu/markers
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_common/Group
      Name: Nav2 Global
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Global Costmap
          Enabled: true
          Alpha: 0.30
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /global_costmap/costmap
            Reliability Policy: Reliable
            Durability Policy: Transient Local
            History Policy: Keep Last
            Depth: 1
          Update Topic:
            Value: /global_costmap/costmap_updates
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: Global Plan
          Enabled: true
          Topic:
            Value: /rviz/plan
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
          Color: 255; 0; 0
          Line Style: Lines
          Line Width: 0.03
          Buffer Length: 1
    - Class: rviz_common/Group
      Name: Nav2 Local
      Enabled: true
      Displays:
        - Class: rviz_default_plugins/Map
          Name: Local Costmap
          Enabled: true
          Alpha: 0.45
          Color Scheme: costmap
          Draw Behind: false
          Topic:
            Value: /local_costmap/costmap
            Reliability Policy: Reliable
            Durability Policy: Transient Local
            History Policy: Keep Last
            Depth: 1
          Update Topic:
            Value: /local_costmap/costmap_updates
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
        - Class: rviz_default_plugins/Path
          Name: Local Plan
          Enabled: true
          Topic:
            Value: /rviz/local_plan
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
          Color: 0; 80; 255
          Line Style: Lines
          Line Width: 0.03
          Buffer Length: 1
        - Class: rviz_default_plugins/Polygon
          Name: Robot Footprint
          Enabled: true
          Color: 0; 255; 0
          Topic:
            Value: /local_costmap/published_footprint
            Reliability Policy: Reliable
            Durability Policy: Volatile
            History Policy: Keep Last
            Depth: 5
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: nav2_rviz_plugins/GoalTool
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: map
      Scale: 65
      Angle: 0
      X: 0
      Y: -2
