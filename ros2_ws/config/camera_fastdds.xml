<?xml version="1.0" encoding="UTF-8"?>
<!-- Large local RGB/depth samples need more than the default 512 KiB segment.
     https://fast-dds.docs.eprosima.com/en/2.x/fastdds/transport/shared_memory/shared_memory.html
     Scope this participant profile to the camera/cloud processes only.
     UDP remains available for discovery and RViz on the Ubuntu laptop. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>camera_shm</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>
      <port_queue_capacity>512</port_queue_capacity>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>camera_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="camera_large_samples" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>camera_shm</transport_id>
        <transport_id>camera_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
