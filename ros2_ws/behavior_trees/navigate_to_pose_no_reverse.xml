<!--
  Prefer the short XY route from GridBased; fall back to the heading-aware
  forward-only planner when GridBased cannot find a path.
  Wait for transient obstacles before one short collision-checked backup.
  Never clear obstacle observations or drive blindly forward in recovery.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="4" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithShortestPathReplanning">
        <RateController hz="0.5" name="RateControllerComputePathToPose">
          <Fallback name="PlannerFallback">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="SE2Fallback" error_code_id="{compute_path_error_code}"/>
          </Fallback>
        </RateController>
        <FollowPath path="{path}" controller_id="FollowPath" error_code_id="{follow_path_error_code}"/>
      </PipelineSequence>
      <ReactiveFallback name="SafeRecovery">
        <GoalUpdated/>
        <RoundRobin name="BoundedRecoveryActions">
          <Sequence name="WaitAndReplan">
            <Wait name="WaitForEnvironmentChange" wait_duration="3.0"/>
            <Fallback name="PlannerAfterWait">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="SE2Fallback" error_code_id="{compute_path_error_code}"/>
            </Fallback>
          </Sequence>
          <Sequence name="BackUpAndReplan">
            <BackUp name="ShortSlowBackUp" backup_dist="0.15" backup_speed="0.08"
                    time_allowance="5.0" error_code_id="{backup_error_code}"/>
            <Fallback name="PlannerAfterBackUp">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased" error_code_id="{compute_path_error_code}"/>
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="SE2Fallback" error_code_id="{compute_path_error_code}"/>
            </Fallback>
          </Sequence>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
